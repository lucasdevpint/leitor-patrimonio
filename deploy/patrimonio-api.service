[Unit]
Description=Sistema Patrimonial - API FastAPI
After=network.target mysql.service

[Service]
Type=simple
User=patrimonio
Group=patrimonio
WorkingDirectory=/opt/patrimonio-v3
Environment="DB_HOST=localhost"
Environment="DB_USER=patrimonio_user"
Environment="DB_PASSWORD=TROQUE_ESSA_SENHA"
Environment="DB_NAME=patrimonio"
Environment="DB_PORT=3306"
Environment="SECRET_KEY=TROQUE_ESSA_CHAVE_SECRETA_BEM_LONGA"
ExecStart=/opt/patrimonio-v3/venv/bin/uvicorn api.app:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=append:/var/log/patrimonio/api.log
StandardError=append:/var/log/patrimonio/api-erro.log

[Install]
WantedBy=multi-user.target
